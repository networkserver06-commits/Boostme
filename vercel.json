{
  "version": 2,
  "builds": [
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/app.js"
    }
  },
  "crons": [
    { "path": "/api/scheduled/sync-catalog", "schedule": "*/30 * * * *" },
    { "path": "/api/scheduled/sync-orders", "schedule": "*/10 * * * *" }
  ]
}
